# ============================================================================
# Go Backend Academy — Environment Configuration (.env)
# ============================================================================
# Copy this file to `.env` (`cp .env.example .env`) and customize as needed.
# The Go server automatically loads `.env` at startup; any variable already set
# in the OS process environment takes precedence over `.env`.

# 1. HTTP Server & Network Binding
APP_ENV=development
HOST=
PORT=8080
READ_HEADER_TIMEOUT_SEC=5
READ_TIMEOUT_SEC=10
WRITE_TIMEOUT_SEC=15
IDLE_TIMEOUT_SEC=60
SHUTDOWN_TIMEOUT_SEC=10
WEB_STATIC_DIR=./web

# 2. Database Driver Selection:
#    - sqlite   : Persistent local file database (default, zero external daemon required)
#    - postgres : Production PostgreSQL database (connects using POSTGRES_* below)
#    - memory   : Ephemeral in-process SQLite database (for isolated tests only)
DB_DRIVER=sqlite

# 3. SQLite Settings (used when DB_DRIVER=sqlite)
#    Change SQLITE_PATH to move the database file, or set SQLITE_DSN to override PRAGMAs.
SQLITE_PATH=./academy.db
SQLITE_DSN=

# 4. PostgreSQL Host, Port & Access Credentials (used when DB_DRIVER=postgres & by docker-compose.yml)
#    Changing POSTGRES_HOST, POSTGRES_PORT, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB,
#    or POSTGRES_SSLMODE here automatically updates the server connection target.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=academy
POSTGRES_PASSWORD=change_this_strong_password_in_prod
POSTGRES_DB=gobackendacademy
POSTGRES_SSLMODE=disable
# Optional full URL override (leave empty so POSTGRES_HOST and POSTGRES_PORT above take effect):
POSTGRES_DSN=

# 5. Connection Pool, Startup Timeout & Automatic Migrations
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=30
DB_CONNECT_TIMEOUT_SEC=5
DB_AUTO_MIGRATE=true
DB_AUTO_SEED=true

# 6. Optional Redis Port (only used when running `docker compose --profile cache up`)
REDIS_PORT=6379

# 7. HTTP Security, CORS & Rate Limiting
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
MAX_REQUEST_BODY_BYTES=1048576

# 8. Offline Diagnostics & Sandbox Execution (Default: AI_PROVIDER=none — 100% offline)
ENABLE_LOCAL_GO_TOOLCHAIN=true
SANDBOX_TIMEOUT_MS=3000
AI_PROVIDER=none
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=
